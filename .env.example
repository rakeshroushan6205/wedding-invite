# Optional: point this at a real backend to receive RSVP submissions
# (Formspree, a Google Apps Script web app, Airtable, your own API route, etc.)
# Until this is set, RSVPs are saved locally in the guest's browser instead.
VITE_RSVP_ENDPOINT=

# Optional Firebase overrides. The supplied wedding Firebase project is used
# when these values are not set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
